# 邮箱验证工作台 MailVault 配置
PORT=3600
HOST=0.0.0.0

# 网页登录密码（首次启动写入数据库，之后请在网页「设置」中修改）
ADMIN_PASSWORD=admin123

# JWT 签名密钥（同时用于兼容解密旧数据，请改成随机长字符串）
JWT_SECRET=please-change-this-to-a-long-random-string

# 数据库文件路径（可选，默认 ../db/codes.db）
# DB_PATH=D:\data\mailhub.db

# 加密种子 seed.php 路径（可选，默认 server/seed.php）
# 容器部署必须指向持久化卷，如 /data/seed.php —— 丢失将导致加密数据无法恢复
# SEED_PATH=/data/seed.php
